# Required — no defaults in production
API_KEY=your-secure-api-key-here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leads

# Optional — defaults shown
REDIS_URL=redis://localhost:6379/0
N8N_WEBHOOK_URL=http://localhost:5678/webhook/score

# Separate key for n8n score callback (defaults to API_KEY if not set)
# Set this to a different value so you can rotate it independently
N8N_API_KEY=your-n8n-service-key-here
